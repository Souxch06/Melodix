+    border-radius: 36px !important;
+    box-shadow:
+        0 24px 64px -24px var(--sf-art-color-from, var(--mel-accent-a)),
+        0 12px 40px -20px var(--sf-art-color-to, var(--mel-accent-b)),
+        0 0 0 1px var(--mel-glass-border) !important;
+    transition: box-shadow 400ms var(--mel-ease-out) !important;
+}
+
+/* Title: 24px / 800 as specified, artist stays subdued but readable. */
+#sf-fs-title {
+    font-size: 24px !important;
+    font-weight: 800 !important;
+    letter-spacing: -0.02em !important;
+    color: var(--mel-text) !important;
+}
+
+#sf-fs-artist {
+    font-size: 15px !important;
+    color: var(--mel-text-dim) !important;
+}
+
+/* Progress: 6px rail, gradient fill, glowing handle. */
+#sf-fs-bar-rail {
+    height: 6px !important;
+    border-radius: var(--mel-radius-pill) !important;
+    background: var(--mel-wash-20) !important;
+    overflow: hidden !important;
+}
+
+#sf-fs-bar-fill {
+    height: 6px !important;
+    border-radius: var(--mel-radius-pill) !important;
+    background-image: linear-gradient(90deg,
+        var(--sf-art-color-from, var(--mel-accent-a)),
+        var(--sf-art-color-to, var(--mel-accent-b))) !important;
