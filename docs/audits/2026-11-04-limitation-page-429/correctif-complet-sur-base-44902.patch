+    box-shadow: var(--mel-shadow-accent) !important;
+}
+
+[data-testid="card"] [data-testid="card-title"] {
+    color: var(--mel-text) !important;
+    font-weight: 700 !important;
+}
+
+[data-testid="card"] [data-testid="card-subtitle"],
+[data-testid="card"] [data-encore-id="cardSubtitle"] {
+    color: var(--mel-text-dim) !important;
+}
+
+/* Track rows: comfortable height, rounded press state */
+[data-testid="tracklist-row"] {
+    border-radius: var(--mel-radius-art) !important;
+    min-height: 56px !important;
+    transition: background-color var(--mel-dur) var(--mel-ease-out) !important;
+}
+
+[data-testid="tracklist-row"]:hover {
+    background-color: var(--mel-glass-bg) !important;
+}
+
+[data-testid="tracklist-row"]:active {
+    background-color: var(--mel-accent-wash-11) !important;
+    transform: scale(0.995) !important;
+}
+
+/* Section headings inside shelves */
+[data-testid="component-shelf"] > div > h2,
+[data-encore-id="shelfHeader"] {
+    color: var(--mel-text) !important;
+    font-weight: 700 !important;
+}
+
+/* --- 10.9 Full-screen player: the one surface we fully own -------------- */
+/* #sf-fs-player is built by spotify_bridge.js, so every selector here is
+   stable by construction (our own ids and classes). */
+
+/* Portrait: the blurred artwork backdrop becomes visible. It was display:none,
+   which is why the player used to sit on a flat colour. */
+#sf-fs-bg {
+    display: block !important;
+    position: absolute !important;
+    inset: 0 !important;
+    z-index: 0 !important;
+    pointer-events: none !important;
+    overflow: hidden !important;
+    background: var(--mel-bg) !important;
+}
+
+/* Dark veil over the blurred artwork: without it the title loses contrast
+   against a bright cover. */
+#sf-fs-bg::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    background: linear-gradient(180deg,
+        var(--mel-fs-veil-top) 0%,
+        var(--mel-fs-veil-mid) 55%,
+        var(--mel-bg) 100%);
+}
+
+#sf-fs-player {
+    font-family: system-ui, -apple-system, "Segoe UI", sans-serif !important;
+    animation: sfFsGlassIn 350ms var(--mel-ease-out) both !important;
