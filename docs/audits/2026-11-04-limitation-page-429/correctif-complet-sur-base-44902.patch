+'use strict';
+const test=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const path=require('node:path');
+const {JSDOM}=require('jsdom');
+const root=path.join(__dirname,'..');
+const read=p=>fs.readFileSync(path.join(root,p),'utf8');
+function boot(status,{profile=false,compiled=false}={}){
+ const dom=new JSDOM(`<!doctype html><html><body><div></div><div></div>${profile?'<button data-testid="user-widget-link"></button><button data-testid="control-button-playpause"></button><aside data-testid="rootlist"><a href="/playlist/37i9dQZF1DXcBWIGoYBM5M">test playlist</a></aside>':''}</body></html>`,{url:'https://open.spotify.com/',runScripts:'outside-only'});
+ const w=dom.window,calls={data:[], loads:[],fetches:0}, timers=[];
+ w.MutationObserver=class{observe(){} disconnect(){}};
+ w.setInterval=()=>0; w.setTimeout=(f,ms)=>{timers.push({f,ms});return timers.length};w.clearTimeout=()=>{};
+ w.fetch=()=>{calls.fetches++;return Promise.reject(new Error('no network'))};
+ w.performance.getEntriesByType=(type)=>type==='navigation'?[{responseStatus:status}]:[];
+ w.SF_CONFIG={};
+ w.AndBridge={onNativeUiRoute(){},onNativeUiReady(){},onNativeUiData:(screen,json)=>calls.data.push({screen,rows:JSON.parse(json)}),logDiagEvent(){},getDiagnosticSessionId:()=>'',onSpotifyLoginRequired(){},loadWebPlayerUrl:url=>calls.loads.push(url)};
+ w.eval(read('assets/runtime_state.js'));
+ w.eval(read(compiled?'assets/native_ui_shell.js':'scripts/native_ui_shell.source.js'));
+ w.eval(read(compiled?'assets/spotify_bridge.js':'scripts/spotify_bridge.source.js'));
+ return {dom,w,calls,timers};
+}
+
+test('HTTP 429 on the top page produces a truthful status instead of unknown login', () => {
+ for(const compiled of [false,true]) {
+  const {dom,calls,w}=boot(429,{compiled});
+  try {w.__sfNativeUiRefresh();const home=calls.data.filter(x=>x.screen==='home').at(-1);assert.equal(home.rows[0].state,'error');assert.match(home.rows[0].title,/limite/i);assert.match(home.rows[0].subtitle,/429/);assert.equal(home.rows[0].sessionUnproven,true);assert.notEqual(w.__sfMediaLibSessionProven,true);} finally {dom.window.close();}
+ }
+});
+
+test('an observed page-level 429 blocks background library fetches and recovery redirects', () => {
+ const {dom,w,calls,timers}=boot(429,{profile:true});
+ try {w.__sfNativeUiRefresh();w.__sfNativeRetryLibrary();for(const t of timers.filter(t=>t.ms===2600))t.f();assert.equal(calls.fetches,0);assert.deepEqual(calls.loads,[]);assert.equal(calls.data.filter(x=>x.screen==='home').at(-1).rows[0].state,'error');} finally {dom.window.close();}
+});
+
