+body:not(.sf-fs-open) aside[data-testid="now-playing-bar"] button[data-testid="control-button-playpause"] {
+    background-image: var(--mel-accent-grad) !important;
+    background-color: transparent !important;
+    color: var(--mel-text-on-accent) !important;
+    box-shadow: var(--mel-shadow-accent) !important;
+    transition: transform var(--mel-dur) var(--mel-ease-out),
+                box-shadow var(--mel-dur) var(--mel-ease-out) !important;
+}
+
+body:not(.sf-fs-open) aside[data-testid="now-playing-bar"] button[data-testid="control-button-playpause"]:active {
+    transform: scale(0.92) !important;
+}
+
+body:not(.sf-fs-open) aside[data-testid="now-playing-bar"] button[data-testid="control-button-playpause"] svg {
+    fill: var(--mel-text-on-accent) !important;
+}
+
+/* The thin progress line under the pill, when Spotify renders it: gradient,
+   rounded, never taller than 3px so the row height cannot change. */
+body:not(.sf-fs-open) aside[data-testid="now-playing-bar"] [data-testid="playback-progressbar"] {
+    border-radius: var(--mel-radius-pill) !important;
+}
+
+/* --- 10.12 The library drawer ------------------------------------------ */
+/* The drawer keeps the geometry the touch shell gives it (fixed, full width,
+   bottom = the token stack, z-index 10005, safe-area aware). It is now a
+   sheet: glass surface, 28px top corners, and a grabber. Only present while
+   the drawer is open, so nothing is added to the closed state. */
+body.sf-library-open #Desktop_LeftSidebar_Id {
+    background-color: var(--mel-glass-scrim) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    border-radius: var(--mel-radius-sheet) var(--mel-radius-sheet) 0 0 !important;
+    box-shadow: var(--mel-glass-shadow), 0 -18px 48px var(--mel-scrim-40) !important;
+    -webkit-backdrop-filter: blur(var(--mel-glass-blur)) saturate(var(--mel-glass-saturate)) !important;
+    backdrop-filter: blur(var(--mel-glass-blur)) saturate(var(--mel-glass-saturate)) !important;
+    overscroll-behavior-y: contain !important;
+}
+
+/* The library panel inside the drawer is transparent: the sheet behind it
+   carries the glass, so the blur is paid once and not once per row. */
+body.sf-library-open #Desktop_LeftSidebar_Id .YourLibraryX {
+    background-color: transparent !important;
+}
+
+/* The grabber: a 36x4 hairline centred on the top edge, painted by the sheet
+   itself (no new element, so it cannot leak into other pages). */
+body.sf-library-open #Desktop_LeftSidebar_Id::before {
+    content: "";
+    position: absolute;
+    top: 6px;
+    left: 50%;
+    width: 36px;
+    height: 4px;
+    margin-left: -18px;
+    border-radius: var(--mel-radius-pill);
+    background-color: var(--mel-glass-border);
+    pointer-events: none;
+    z-index: 3;
+}
+
+/* Header: the close button becomes a 44px glass pill, aligned with the
+   grabber, and the title keeps the drawer's own 56px row. */
+body.sf-library-open #Desktop_LeftSidebar_Id .sf-mobile-library-close {
+    width: 44px !important;
+    height: 44px !important;
+    min-width: 44px !important;
+    min-height: 44px !important;
+    border-radius: var(--mel-radius-pill) !important;
+    background-color: var(--mel-glass-bg-strong) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    color: var(--mel-text) !important;
+    transition: transform var(--mel-dur) var(--mel-ease-out),
+                background-color var(--mel-dur) var(--mel-ease-out) !important;
+}
+
+body.sf-library-open #Desktop_LeftSidebar_Id .sf-mobile-library-close:active {
+    transform: translateY(-50%) scale(0.92) !important;
+}
+
+/* The drawer's rows: the same 56px touch row as the rest of the app, with a
+   rounded press state instead of a full-bleed highlight. */
+body.sf-library-open #Desktop_LeftSidebar_Id [role="row"],
+body.sf-library-open #Desktop_LeftSidebar_Id li {
+    border-radius: var(--mel-radius-art) !important;
+}
+
+/* Only one drawer at a time: the sheet gets a scrim over the content it
+   covers, and the content stays scrollable underneath (no pointer trap). */
+body.sf-library-open #main-view::after {
+    content: "";
+    position: fixed;
+    inset: 0;
+    background-color: var(--mel-scrim-40);
+    pointer-events: none;
+    z-index: 10004;
+}
+
+/* --- 10.15 Secondary buttons: native glass, not a flat pill -------------- */
+/* A button that is a single flat fill reads as a web link even when it is the
+   right size. The native card already paints its secondary actions with
+   `native_button_dark`; this gives the WebView the same construction so the
+   two never look like different products: a translucent violet fill, a 1px
+   hairline, and a 1px white reflection along the top edge. The gradient is the
+   reflection — it is what makes the surface look lit from above. */
+#main-view button[data-encore-id="buttonSecondary"],
+#main-view [role="button"][data-encore-id="buttonSecondary"],
+#main-view [data-testid="action-bar-row"] button:not(.mel-accent-fill) {
+    background-image: var(--mel-glass-grad) !important;
+    background-color: var(--mel-glass-bg) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    box-shadow: var(--mel-glass-shadow) !important;
+}
+
+/* --- 10.17 Portrait and landscape: same pill, no stretching ------------- */
+/* The dock rule is scoped to portrait phones, but its second half — `(hover:
+   none) and (pointer: coarse)` — has no max-width, so it also matches a
+   landscape tablet. That is intentional: the app-style dock stays the primary
+   navigation in both orientations, and it cannot stretch, because it is
+   centred and capped at 560px while its width tracks the viewport minus the
+   two insets. What has to be checked is the content it floats over, and that
+   is what these two rules do — they never remove a control. */
+@media screen and (orientation: landscape) and (hover: none) and (pointer: coarse) {
+    /* The library drawer and the mini player are lifted by the same stack on a
+       tablet as on a phone; on a wide window that lift is what keeps them off
+       the pill instead of sliding under it. */
+    body.sf-library-open #Desktop_LeftSidebar_Id {
+        max-width: min(420px, 42vw) !important;
+    }
+
+    /* A landscape tablet keeps its desktop side rail, so the content column
+       gets a symmetric gutter rather than hugging the rail. */
+    #main-view .contentSpacing {
+        padding-left: 24px !important;
+        padding-right: 24px !important;
+    }
+}
+
+/* A short phone in landscape (a 360x640 handset rotated) has ~300px of height:
+   the full-screen player's two-column grid would clip the metadata. It falls
+   back to the stacked phone layout, artwork capped, nothing cut off. */
+@media screen and (orientation: landscape) and (max-height: 400px) {
+    #sf-fs-player {
+        display: flex !important;
+        flex-direction: column !important;
+        align-items: center !important;
+        justify-content: flex-start !important;
+    }
+
+    #sf-fs-art {
+        max-width: 38vh !important;
+        max-height: 38vh !important;
+    }
+}
+
+/* Tablets in portrait keep the pill (it is centred and capped), but the
+   content gutter grows so the pill never looks pinched. */
+@media screen and (min-width: 600px) and (orientation: portrait) {
+    #main-view .contentSpacing {
+        padding-left: 24px !important;
+        padding-right: 24px !important;
+    }
+}
+
+/* --- 10.16 The header: glow on top, round glass buttons ------------------ */
+/* 44dp round buttons with a glass fill. `min-width`/`min-height` (not width)
+   so a longer icon never clips, and the radius stays a circle because the box
+   is square. The glow sits behind the whole bar, never over the content. */
+[data-testid="top-bar"] button {
+    min-width: 44px !important;
+    min-height: 44px !important;
+    border-radius: var(--mel-radius-pill) !important;
+    background-color: var(--mel-glass-bg) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    box-shadow: var(--mel-glass-highlight) 0 1px 0 inset !important;
+}
+
+[data-testid="global-nav-bar"]::before,
+[data-testid="top-bar"]::before {
+    content: "";
+    position: absolute;
+    inset: -50% 10% auto 10%;
+    height: 140%;
+    pointer-events: none;
+    z-index: 0;
+    background: radial-gradient(60% 100% at 50% 0%, var(--mel-glow-a) 0%, transparent 70%);
+    opacity: 0.5;
+}
+
+/* --- 10.13 Making the glass readable ------------------------------------ */
+/* A frosted surface can only show through when something colourful sits
+   behind it. Three moves, in order:
+     1. the backdrop glows get a stronger, larger presence;
+     2. the scrolling content is lifted onto its own translucent sheet so the
+        glows are visible *through* the app, not only around it;
+     3. cards and secondary buttons receive the glass recipe, which is what
+        makes their edges and highlights read as frosted rather than flat. */
+
+/* 1. Two fixed glows: violet top-left, magenta right. Deeper than a hint,
+   still far from a wash — the text contrast budget is measured with them on
+   (see the AA tests). */
+body::before {
+    background:
+        radial-gradient(90% 62% at -8% -6%, var(--mel-glow-a) 0%, transparent 62%),
+        radial-gradient(85% 58% at 104% 8%, var(--mel-glow-b) 0%, transparent 60%),
+        radial-gradient(70% 45% at 50% 108%, var(--mel-glow-a) 0%, transparent 68%) !important;
+    opacity: 0.72 !important;
+}
+
+body::after {
+    content: "";
+    position: fixed;
+    inset: 0;
+    z-index: -1;
+    pointer-events: none;
+    background: linear-gradient(180deg, var(--mel-glass-wash-top) 0%, transparent 34%);
+}
+
+/* 2. The scrolling surface becomes a very light veil, so the glows read
+   through the content itself. 4% white is invisible as a tint but enough for
+   a blurred surface on top of it to have something to diffuse. */
+#main-view,
+#main-view [data-overlayscrollbars-viewport],
+#Desktop_LeftSidebar_Id {
+    background-color: var(--mel-view-wash) !important;
+}
+
+/* 3a. Cards: the full recipe — translucent fill, hairline, inset highlight.
+   Radius, shadow and press feedback are already set by 10.8; this only adds
+   the material. */
+/* Cards scroll: they get the glass MATERIAL (translucent fill, hairline,
+   inset highlight) but never a backdrop-filter. Blurring every card in a
+   scrolling shelf is the one thing the brief rules out, and the veil behind
+   them already gives the same frosted read. */
+[data-testid="card"] {
+    background-color: var(--mel-glass-bg) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    box-shadow: var(--mel-glass-shadow), var(--mel-shadow-card) !important;
+}
+
+/* 3b. Secondary buttons: any control that is not the gradient primary. The
+   :not() list keeps play buttons, the gradient fill and the accent surfaces
+   out of the way, so nothing that was already readable changes colour. */
+[data-testid="card"] button:not([data-testid="control-button-playpause"]),
+#main-view button[data-encore-id="buttonSecondary"],
+#main-view [data-testid="action-bar-row"] button:not(.mel-accent-fill),
+#main-view [role="button"][data-encore-id="buttonSecondary"] {
+    background-color: var(--mel-glass-bg) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    box-shadow: var(--mel-glass-highlight) 0 1px 0 inset !important;
+    border-radius: var(--mel-radius-pill) !important;
+    min-height: 44px !important;
+    color: var(--mel-text) !important;
+    transition: background-color var(--mel-dur) var(--mel-ease-out),
+                transform var(--mel-dur) var(--mel-ease-out) !important;
+}
+
+[data-testid="card"] button:not([data-testid="control-button-playpause"]):active,
+#main-view button[data-encore-id="buttonSecondary"]:active,
+#main-view [data-testid="action-bar-row"] button:not(.mel-accent-fill):active {
+    transform: scale(0.97) !important;
+    background-color: var(--mel-glass-bg-strong) !important;
+}
+
+/* The primary action inside a card keeps its gradient and never picks up the
+   glass pill above: white on the gradient is 5.70:1, glass would lose it. */
+[data-testid="card"] button.mel-accent-fill,
+[data-testid="card"] [data-testid="play-button"] {
+    border: 0 !important;
+    background-color: transparent !important;
+    background-image: var(--mel-accent-grad) !important;
+}
