+    background-color: var(--mel-glass-bg) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    border-radius: var(--mel-radius-pill) !important;
+    -webkit-backdrop-filter: blur(var(--mel-glass-blur-sm)) saturate(var(--mel-glass-saturate));
