diff --git a/scripts/verify_apk_signer_guard.py b/scripts/verify_apk_signer_guard.py
new file mode 100644
index 0000000..6881459
--- /dev/null
+++ b/scripts/verify_apk_signer_guard.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Verify that an APK's *compiled* signing guard matches its actual signer.
+
+Usage: python3 verify_apk_signer_guard.py APK --java JAVA --apktool JAR
+       --apksig-classes CLASSES
+This is a post-signing check, not a substitute for a launch on an Android device.
+"""
+import argparse
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+import xml.etree.ElementTree as ET
+
+GUARD = 'expected_signature_sha256'
+COLON_DIGEST = re.compile(r'^(?:[0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2}$')
+
+
+def guard_values(resource_directory):
+    found = []
+    for values in sorted(Path(resource_directory).glob('values*')):
+        if not values.is_dir():
+            continue
+        for xml in sorted(values.glob('*.xml')):
+            root = ET.parse(xml).getroot()
+            for item in root.findall('string'):
+                if item.get('name') == GUARD:
+                    found.append((str(xml), ''.join(item.itertext())))
+    if not found:
+        raise ValueError('compiled guard resource is missing')
+    return found
+
+
+def verify_guard(verify_output, resources):
+    if not re.search(r'^Verifies\s*$', verify_output, re.M):
+        raise ValueError('APK signature did not verify')
+    for scheme in ('v2', 'v3'):
+        if not re.search(r'^Verified using ' + scheme + r' scheme .*: true\s*$', verify_output, re.M):
+            raise ValueError('missing verified ' + scheme + ' signature')
+    if not re.search(r'^Number of signers: 1\s*$', verify_output, re.M):
+        raise ValueError('expected exactly one APK signer')
+    match = re.search(r'^Signer #1 certificate SHA-256 digest: ([0-9a-fA-F]{64})\s*$', verify_output, re.M)
+    if not match:
+        raise ValueError('missing signer certificate SHA-256')
+    digest = match.group(1).upper()
+    expected = ':'.join(digest[i:i + 2] for i in range(0, 64, 2))
+    for path, value in guard_values(resources):
+        # Android compares this string case-insensitively but does not strip or
+        # reformat it. Reject malformed, UNKNOWN, empty or overridden values.
+        if not COLON_DIGEST.fullmatch(value) or value.upper() != expected:
+            raise ValueError('compiled signing guard does not match APK certificate: ' + path)
+    return digest
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('apk')
+    parser.add_argument('--java', required=True)
+    parser.add_argument('--apktool', required=True)
+    parser.add_argument('--apksig-classes', required=True)
+    args = parser.parse_args()
+    with tempfile.TemporaryDirectory(prefix='melodix-signature-check-') as temp:
+        output = subprocess.run([
+            args.java, '-cp', args.apksig_classes, 'com.android.apksigner.ApkSignerTool',
+            'verify', '--verbose', '--print-certs', '--min-sdk-version', '24',
+            '--max-sdk-version', '36', args.apk,
+        ], check=True, capture_output=True, text=True).stdout
+        decoded = Path(temp) / 'decoded'
+        subprocess.run([args.java, '-jar', args.apktool, 'd', '-f', '-s', args.apk,
+                        '-o', str(decoded)], check=True, capture_output=True, text=True)
+        digest = verify_guard(output, decoded / 'res')
+    print('Compiled signature guard matches verified APK certificate: ' + digest)
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, subprocess.CalledProcessError, OSError, ET.ParseError) as exc:
+        print('Signature guard verification failed: ' + str(exc), file=sys.stderr)
+        sys.exit(1)
