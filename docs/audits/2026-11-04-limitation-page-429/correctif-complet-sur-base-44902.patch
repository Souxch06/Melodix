+// Structural checks for the Android handoff; device interaction still needs a real device.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const root = path.resolve(__dirname, '..');
+function method(file, name) {
+    const source = fs.readFileSync(path.join(root, file), 'utf8');
+    const found = source.match(new RegExp('\\.method[^\\n]*\\b' + name + '\\([^\\n]*\\n[\\s\\S]*?\\.end method'));
+    assert.ok(found, name);
+    return found[0];
+}
+const main = 'smali/com/melodix/music/MainActivity.smali';
+test('a cold page finish reveals an existing login path before native takeover', () => {
+    const m = method(main, 'onWebViewPageFinished');
+    assert.ok(m.indexOf('->isLoginWebPath()Z') < m.indexOf('->showNativeUiFrom('));
+    assert.ok(m.indexOf('->revealLoginWebUi()V') < m.indexOf('->showNativeUiFrom('));
+});
+test('login request is posted on the UI thread and restricted to HTTPS Spotify player', () => {
+    const b = method('smali/com/melodix/music/AndBridge.smali', 'onSpotifyLoginRequired');
+    assert.match(b, /JavascriptInterface/);
+    assert.match(b, /runOnUiThread/);
+    const r = method('smali/com/melodix/music/NativeUiUpdateRunnable.smali', 'run');
+    assert.match(r, /openSpotifyLoginIfPlayerPage/);
+    const m = method(main, 'openSpotifyLoginIfPlayerPage');
+    assert.match(m, /getScheme/);
+    assert.match(m, /getHost/);
+    assert.match(m, /open\.spotify\.com/);
+    assert.ok(m.indexOf('->isLoginWebPath()Z') < m.indexOf('->openSpotifyLogin()V'));
+    assert.match(m, /->revealLoginWebUi\(\)V/);
+});
+
+test('switching from another screen to Home clears the shared stale content', () => {
+    const m = method(main, 'setNativeScreen');
+    assert.match(m, /nativeCurrentScreen:Ljava\/lang\/String;[\s\S]*?if-eqz v0, :native_home_clear_done/);
+    assert.match(m, /const-string v1, "home"[\s\S]*?0x7f090235[\s\S]*?removeAllViews/);
+});
diff --git a/tests/test_verify_apk_signer_guard.py b/tests/test_verify_apk_signer_guard.py
new file mode 100644
index 0000000..73e6628
--- /dev/null
+++ b/tests/test_verify_apk_signer_guard.py
@@ -0,0 +1,51 @@
+import importlib.util
+import tempfile
+import unittest
+from pathlib import Path
+
+spec = importlib.util.spec_from_file_location('guard', Path(__file__).resolve().parents[1] / 'scripts/verify_apk_signer_guard.py')
+guard = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(guard)
+CERT = '12' * 32
+GOOD = ('Verifies\nVerified using v2 scheme (APK Signature Scheme v2): true\n'
+        'Verified using v3 scheme (APK Signature Scheme v3): true\n'
+        'Number of signers: 1\nSigner #1 certificate SHA-256 digest: ' + CERT + '\n')
+
+class GuardTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        (self.root / 'values').mkdir()
+        self.add_guard(self.root / 'values/strings.xml', ':'.join(['12'] * 32))
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    @staticmethod
+    def add_guard(path, text):
+        path.write_text('<resources><string name="expected_signature_sha256">' + text + '</string></resources>')
+
+    def test_matching_guard(self):
+        self.assertEqual(guard.verify_guard(GOOD, self.root), CERT.upper())
+
+    def test_reject_mismatch_and_malformed(self):
+        for bad in [':'.join(['34'] * 32), CERT, 'UNKNOWN', ' ' + ':'.join(['12'] * 32)]:
+            self.add_guard(self.root / 'values/strings.xml', bad)
+            with self.assertRaises(ValueError):
+                guard.verify_guard(GOOD, self.root)
+
+    def test_reject_locale_override(self):
+        (self.root / 'values-fr').mkdir()
+        self.add_guard(self.root / 'values-fr/strings.xml', ':'.join(['34'] * 32))
+        with self.assertRaises(ValueError):
+            guard.verify_guard(GOOD, self.root)
+
+    def test_reject_bad_verification(self):
+        for bad in [GOOD.replace('Verifies', 'Does not verify', 1),
+                    GOOD.replace('v3): true', 'v3): false'),
+                    GOOD.replace('Number of signers: 1', 'Number of signers: 2')]:
+            with self.assertRaises(ValueError):
+                guard.verify_guard(bad, self.root)
+
+if __name__ == '__main__':
+    unittest.main()
