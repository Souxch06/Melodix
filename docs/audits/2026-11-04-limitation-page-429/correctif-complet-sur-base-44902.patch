+/* =========================================================================
+   SECTION 10: MELODIX GLASS THEME
+   -------------------------------------------------------------------------
+   This section comes last on purpose: the cascade makes it win over the
+   earlier rules without rewriting them. It adds NOTHING that removes an
+   existing mask, a safe-area rule or an sf-* mode; it only repaints.
+
+   Colour rules of the house, enforced by tests/css_theme_integrity.test.js:
+     - every colour comes from a --mel-* token declared in the single :root;
+     - --mel-accent is the READABLE accent (AA on the dark background), while
+       --mel-accent-grad is the brand gradient used as a background.
+   ========================================================================= */
+
+/* --- 10.1 The backdrop: flat dark base + two fixed glows ---------------- */
+html,
+body {
+    background-color: var(--mel-bg) !important;
+}
+
+body::before {
+    content: "";
+    position: fixed;
+    inset: 0;
+    z-index: -1;
+    pointer-events: none;
+    background:
+        radial-gradient(120% 80% at 0% 0%, var(--mel-glow-a) 0%, transparent 58%),
+        radial-gradient(110% 75% at 100% 12%, var(--mel-glow-b) 0%, transparent 55%);
+    opacity: 0.55;
+}
+
+/* --- 10.2 The glass recipe --------------------------------------------- */
+/* Applied only to the four surfaces that float above content: the top bar,
+   the mini player, the tab bar and the full-screen player. Never to a
+   scrolling area — backdrop-filter over a long list drops frames. */
+.mel-glass-surface {
+    background-color: var(--mel-glass-bg) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    box-shadow: var(--mel-glass-shadow) !important;
+    -webkit-backdrop-filter: blur(var(--mel-glass-blur)) saturate(var(--mel-glass-saturate));
+    backdrop-filter: blur(var(--mel-glass-blur)) saturate(var(--mel-glass-saturate));
+}
+
+/* --- 10.3 Accent surfaces ---------------------------------------------- */
+/* A single class for every place that used to be green: filled with the
+   gradient and carrying WHITE text (5.70:1 on the violet end, 4.60:1 on the
+   magenta end — both AA for normal text). */
+.mel-accent-fill,
+button[data-testid="control-button-playpause"].mel-accent-fill {
+    background-image: var(--mel-accent-grad) !important;
+    background-color: transparent !important;
+    color: var(--mel-text-on-accent) !important;
+    border: 0 !important;
+    box-shadow: var(--mel-shadow-accent), var(--mel-shadow-accent-b) !important;
+}
+
+/* --- 10.4 Focus and active states -------------------------------------- */
+/* :focus-visible keeps the d-pad / keyboard behaviour the TV mode relies on;
+   touch and mouse never see the ring. */
+a:focus-visible,
+button:focus-visible,
+[role="button"]:focus-visible,
+[role="link"]:focus-visible,
+[role="tab"]:focus-visible,
+[role="option"]:focus-visible,
+input:focus-visible,
+[tabindex]:focus-visible {
+    outline: 2px solid var(--mel-accent) !important;
+    outline-offset: 2px !important;
+}
+
+/* --- 10.5 The no-blur fallback ---------------------------------------- */
+/* WebView on API 24-28 has no backdrop-filter. The surfaces then use a
+   near-opaque fill so text stays readable — degraded, never broken. */
+@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
+    .mel-glass-surface {
+        background-color: var(--mel-glass-fallback-bg) !important;
+        -webkit-backdrop-filter: none;
+        backdrop-filter: none;
+    }
+
+    body::before {
+        opacity: 0.35;
+    }
+}
+
+/* --- 10.6 The opt-out hook -------------------------------------------- */
+/* body.mx-glass-off turns every frosted surface opaque. Nothing toggles the
+   class yet; it exists so a future accessibility setting can, without
+   touching any rule above. */
+body.mx-glass-off .mel-glass-surface,
+body.mx-glass-off #global-nav-bar,
+body.mx-glass-off aside[data-testid="now-playing-bar"],
+body.mx-glass-off #sf-mobile-nav {
+    background-color: var(--mel-glass-fallback-bg-strong) !important;
+    -webkit-backdrop-filter: none !important;
+    backdrop-filter: none !important;
+}
+
+/* --- 10.7 Motion ------------------------------------------------------- */
+@media (prefers-reduced-motion: reduce) {
+    .mel-glass-surface {
+        transition: none !important;
+    }
+}
+
+/* --- 10.8 Home, lists and cards ---------------------------------------- */
+/* Every selector below is either a data-testid/data-encore-id, an aria-label,
+   or a well-known id. If Spotify renames one, the rule simply stops matching:
+   the app keeps working, just less styled (see docs/ui-design-system.md). */
+
+/* Titles: bigger, tighter, brighter. h1/h2 only exist inside content areas,
+   so this cannot leak into Spotify's own chrome. */
+#main-view h1,
+#main-view h2,
+[data-testid="home-page"] h1,
+[data-testid="home-page"] h2 {
+    color: var(--mel-text) !important;
+    letter-spacing: -0.02em !important;
+    font-weight: 800 !important;
+}
+
+/* Filter chips above the shelves */
+[data-testid="chip"],
+[data-encore-id="chip"],
+#main-view [role="tablist"] [role="tab"] {
+    background-color: var(--mel-glass-bg) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    border-radius: var(--mel-radius-pill) !important;
+    color: var(--mel-text-2) !important;
+    min-height: 44px !important;
+    padding: 0 16px !important;
+    transition: background-color var(--mel-dur) var(--mel-ease-out),
+                color var(--mel-dur) var(--mel-ease-out),
+                transform var(--mel-dur) var(--mel-ease-out) !important;
+}
+
+/* Selected chip: the gradient fill with white text */
+[data-testid="chip"][aria-selected="true"],
+[data-encore-id="chip"][aria-selected="true"],
+[data-testid="chip"][data-active="true"],
+#main-view [role="tablist"] [role="tab"][aria-selected="true"] {
+    background-image: var(--mel-accent-grad) !important;
+    background-color: transparent !important;
+    border-color: transparent !important;
+    color: var(--mel-text-on-accent) !important;
+}
+
+[data-testid="chip"]:active {
+    transform: scale(0.97) !important;
+}
+
+/* Cards: 24px radius, rounded artwork, coloured shadow */
+[data-testid="card"] {
+    background-color: var(--mel-glass-bg) !important;
+    border: 1px solid var(--mel-glass-border) !important;
+    border-radius: var(--mel-radius-card) !important;
+    box-shadow: var(--mel-shadow-card) !important;
+    overflow: hidden !important;
+    transition: transform var(--mel-dur) var(--mel-ease-out),
+                box-shadow var(--mel-dur) var(--mel-ease-out) !important;
+}
+
+[data-testid="card"] img,
+[data-testid="card"] [data-testid="card-image"] {
+    border-radius: var(--mel-radius-art) !important;
+}
+
+[data-testid="card"]:active {
