diff --git a/tests/full_glass_overlay.test.js b/tests/full_glass_overlay.test.js
new file mode 100644
index 0000000..38f080d
--- /dev/null
+++ b/tests/full_glass_overlay.test.js
@@ -0,0 +1,110 @@
+'use strict';
+// The reference is the historical Glass CSS (cf5d4952); the native shell
+// retains the original routing and Android IDs while importing visual assets.
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const crypto = require('node:crypto');
+const fs = require('node:fs');
+const path = require('node:path');
+const root = path.resolve(__dirname, '..');
+const read = (p) => fs.readFileSync(path.join(root, p), 'utf8');
+const sha = (p) => crypto.createHash('sha256').update(fs.readFileSync(path.join(root, p))).digest('hex');
+
+test('complete WebView CSS matches the historical Glass reference', () => {
+    assert.equal(sha('assets/css_hacks.css'), '0d1ab6aa71f6978c5b5e1268566306d2811dfcf30c83831027293d36c38ab2f3');
+    const css = read('assets/css_hacks.css');
+    assert.match(css, /SECTION 10: MELODIX GLASS THEME/);
+    assert.match(css, /#sf-mobile-nav\s*\{[\s\S]*?border-radius:\s*34px/);
+    assert.match(css, /@supports\s+not\s*\(\s*\(\s*backdrop-filter\s*:\s*blur\(1px\)/i);
+});
+
+test('native glass header, floating tab bar, and assets match the reference', () => {
+    const layout = read('res/layout/activity_main.xml');
+    assert.match(layout, /android:background="@drawable\/native_header_glass"/);
+    assert.match(layout, /android:id="@id\/nativeTabBar"[\s\S]*?android:background="@drawable\/native_tabbar_glass"[\s\S]*?android:layout_marginLeft="@dimen\/mel_tab_side_inset"[\s\S]*?android:layout_marginBottom="@dimen\/mel_tab_bottom_lift"/);
+    for (const callback of ['onNativeHomeClick', 'onNativeSearchClick', 'onNativeLibraryClick']) {
+        assert.match(layout, new RegExp(`android:onClick="${callback}"`));
+    }
+    const expected = {
+        'native_header_glass.xml': '950f21e0c37a2d87a227ff07a958306c9ff48fd2bb8729bc0e917b325c4a5383',
+        'native_icon_glass.xml': '14657055fa2ef3d44c286733c649bafc203d1e205afd01c9a03493023376df4f',
+        'native_settings_selected.xml': '8cbcd59d1d819b9acc0f69b1f782936a30c088add90b49ce5009c8d20b026e6a',
+        'native_tabbar_glass.xml': '5d9ced0232f809a10c883915e12ac8fba669e41d7e1c700a09b912d0f2b4ef55'
+    };
+    for (const [file, hash] of Object.entries(expected)) assert.equal(sha('res/drawable/' + file), hash);
+    const activity = read('smali/com/melodix/music/MainActivity.smali');
+    const style = activity.match(/\.method public final styleNativeTab\([^\n]*\n[\s\S]*?\.end method/)[0];
+    assert.match(style, /setSelected\(Z\)V/);
+    assert.match(style, /native_tab_active/);
+    assert.match(style, /:native_tab_restore_ripple[\s\S]*?setBackgroundResource/);
+    assert.match(read('res/values/mel_dimens.xml'), /name="mel_tab_side_inset"/);
+    assert.match(read('res/values-sw600dp/mel_dimens.xml'), /name="mel_gutter"/);
+});
+
+test('Web fallback and drawer reserve the same inset-aware Glass stack', () => {
+    const css = read('assets/css_hacks.css');
+    const bridge = read('scripts/spotify_bridge.source.js');
+    const start = bridge.indexOf('function ensureMobileShellFallbackStyles()');
+    const begin = bridge.indexOf('style.textContent = `', start);
+    const end = bridge.indexOf('`;', begin);
+    assert.ok(start >= 0 && begin > start && end > begin);
+    const fallback = bridge.slice(begin, end);
+    const stack = 'var(--sf-dock-lift, 24px) + var(--sf-dock-h, 68px) + var(--sf-mini-gap, 10px) + var(--sf-mini-h, 68px) + var(--sf-stack-gap, 4px)';
+    for (const text of [css, fallback, bridge]) assert.ok(text.includes(stack), 'identical stack tokens');
+    assert.match(fallback, /left: 50% !important;[\s\S]*?transform: translateX\(-50%\)/);
+    assert.match(fallback, /width: calc\(100vw - \(2 \* var\(--sf-dock-inset, 16px\)\)\)[\s\S]*?max-width: 560px/);
+    assert.match(bridge, /ls\.style\.setProperty\('bottom', `calc\(\$\{stack\} \+ var\(--sf-safe-area-bottom/);
+    // Fallback values at zero bottom inset: the drawer clears the player,
+    // which clears the 68px dock at 24px + the system inset.
+    const [lift, dock, miniGap, mini, stackGap] = [24, 68, 10, 68, 4];
+    assert.equal(lift + dock + miniGap, 102);
+    assert.equal(lift + dock + miniGap + mini + stackGap, 174);
+});
+
+test('native tab buttons and header actions keep at least 48dp touch height', () => {
+    const xml = read('res/values/mel_dimens.xml');
+    const tablet = read('res/values-sw600dp/mel_dimens.xml');
+    const dim = (text, name) => Number(text.match(new RegExp(`<dimen name="${name}">([\\d.]+)dip</dimen>`))[1]);
+    for (const text of [xml, tablet]) {
+        assert.ok(dim(text, 'mel_header_action') >= 48);
+        const barHeight = /name="mel_tab_bar_height"/.test(text) ? dim(text, 'mel_tab_bar_height') : dim(xml, 'mel_tab_bar_height');
+        assert.ok(barHeight - 2 * dim(xml, 'mel_liquid_inset') >= 48);
+    }
+});
+
+test('library tap presents the existing WebView and restores it on close or activity destruction', () => {
+    const activity = read('smali/com/melodix/music/MainActivity.smali');
+    const dialog = read('smali/com/melodix/music/NativeLibraryWebDialog.smali');
+    const getMethod = (source, name) => {
+        const pattern = new RegExp('\\.method [^\\n]*\\b' + name + '\\([^\\n]*\\n[\\s\\S]*?\\.end method');
+        const found = source.match(pattern); assert.ok(found, name); return found[0];
+    };
+    const click = getMethod(activity, 'onNativeLibraryClick');
+    const destroy = getMethod(activity, 'onDestroy');
+    const open = getMethod(dialog, 'openFor');
+    const openHome = getMethod(dialog, 'openHome');
+    assert.match(openHome, /openFor\(Lcom\/melodix\/music\/MainActivity;I\)Z/);
+    const restore = getMethod(dialog, 'restore');
+    const dismiss = getMethod(dialog, 'onDismiss');
+    assert.match(click, /window\.__sfOpenLibrary && window\.__sfOpenLibrary\(\)/);
+    assert.doesNotMatch(click, /NativeLibraryWebDialog;->open/);
+    assert.match(open, /MainActivity;->G:Landroid\/webkit\/WebView;/);
+    assert.doesNotMatch(open, /new-instance\s+\w+,\s+Landroid\/webkit\/WebView;/);
+    assert.match(open, /removeView\(Landroid\/view\/View;\)V[\s\S]*?addView\(Landroid\/view\/View;Landroid\/view\/ViewGroup\$LayoutParams;\)V/);
+    assert.match(open, /https:\/\/open\.spotify\.com\/collection\/playlists/);
+    assert.match(open, /setOnDismissListener/);
+    assert.match(open, /:open_restore[\s\S]*?->restore\(\)V/);
+    assert.match(restore, /originalParent[\s\S]*?originalIndex[\s\S]*?originalParams[\s\S]*?addView\(Landroid\/view\/View;ILandroid\/view\/ViewGroup\$LayoutParams;\)V/);
+    assert.match(dismiss, /->restore\(\)V[\s\S]*?nativeLibraryWebDialog/);
+    assert.match(destroy, /nativeLibraryWebDialog[\s\S]*?->dismiss\(\)V/);
+    assert.doesNotMatch(dialog, /onNativeUiData|evaluateJavascript|CookieManager|Log;->/);
+});
+
+test('live library data requires connected UI without becoming API proof', () => {
+    const shell = read('scripts/native_ui_shell.source.js');
+    const home = shell.slice(shell.indexOf('function updateHomeRows('), shell.indexOf('function currentSearchQuery'));
+    const library = shell.slice(shell.indexOf('function mayReadLiveLibraryPage('), shell.indexOf('function updateDetailRows('));
+    assert.match(home, /currentSpotifyAuthUiState\(\) === 'connected'[\s\S]*?collectLibraryDrawerRows/);
+    assert.match(library, /return state === 'connected'/);
+    assert.match(shell, /takeoverProven = sessionProven/);
+});
diff --git a/tests/live_library_dom.test.js b/tests/live_library_dom.test.js
new file mode 100644
index 0000000..9c344c7
--- /dev/null
+++ b/tests/live_library_dom.test.js
@@ -0,0 +1,234 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { JSDOM } = require('jsdom');
+const source = fs.readFileSync(path.join(__dirname, '../scripts/native_ui_shell.source.js'), 'utf8');
+
+function boot(pathname, authState = 'connected') {
+    const dom = new JSDOM(`<!doctype html><html><body>
+      <header><button data-testid="user-widget-link">Compte</button></header>
+      <aside data-testid="rootlist">
+        <a href="/playlist/37i9dQZF1DXcBWIGoYBM5M"><img src="https://i.scdn.co/image/abc" alt="Ma playlist">Ma playlist</a>
+        <a href="https://outside.invalid/playlist/37i9dQZF1DXcBWIGoYBM5M">Lien externe</a>
+      </aside>
+      <main id="main-view"><section><h2>Votre bibliothèque</h2>
+        <article data-testid="card"><a href="/playlist/37i9dQZF1DXcBWIGoYBM5M"><img src="https://i.scdn.co/image/abc" alt="Ma playlist">Ma playlist</a></article>
+      </section></main>
+      <button data-testid="control-button-playpause">Lecture</button>
+    </body></html>`, { url: `https://open.spotify.com${pathname}`, runScripts: 'outside-only' });
+    const w = dom.window;
+    // Refresh is driven explicitly; avoid pending observers after jsdom closes.
+    w.MutationObserver = class { observe() {} disconnect() {} };
+    const calls = { routes: [], data: [], ready: 0 };
+    w.__sfSpotifyAuthUiState = authState;
+    w.__sfMediaLibSessionProofKnown = true;
+    w.__sfMediaLibSessionProven = false;
+    w.mediaLib = { playlists: [{ name: 'Ancienne donnée', uri: 'spotify:playlist:stale' }] };
+    w.AndBridge = {
+        onNativeUiRoute: r => calls.routes.push(r),
+        onNativeUiReady: () => calls.ready++,
+        onNativeUiData: (screen, json) => calls.data.push({ screen, rows: JSON.parse(json) }),
+        logDiagEvent: () => {}, getDiagnosticSessionId: () => '',
+        loadWebPlayerUrl: () => {}, onSpotifyLoginRequired: () => {}
+    };
+    w.eval(source);
+    return { dom, w, calls };
+}
+
+test('connected real DOM sends current drawer playlist to native Home, not the stale cache', () => {
+    const { dom, calls, w } = boot('/');
+    try {
+        const payload = calls.data.filter(x => x.screen === 'home').at(-1);
+        assert.ok(payload);
+        assert.equal(payload.rows[0].title, 'Ma playlist');
+        assert.equal(payload.rows[0].uri, 'spotify:playlist:37i9dQZF1DXcBWIGoYBM5M');
+        assert.doesNotMatch(JSON.stringify(payload.rows), /Ancienne donnée|Lien externe/);
+        assert.equal(w.__sfNativeUiSessionProven, false);
+    } finally { dom.window.close(); }
+});
+
+test('connected real collection DOM opens native library and updates when the card disappears', () => {
+    const { dom, w, calls } = boot('/collection/playlists');
+    try {
+        assert.equal(calls.routes.at(-1), 'library');
+        let payload = calls.data.filter(x => x.screen === 'media:playlists').at(-1);
+        assert.ok(payload && payload.rows.some(row => row.title === 'Ma playlist'));
+        w.document.querySelector('article').remove();
+        w.__sfNativeUiRefresh();
+        payload = calls.data.filter(x => x.screen === 'media:playlists').at(-1);
+        assert.equal(payload.rows.length, 0);
+        assert.equal(w.__sfNativeUiSessionProven, false);
+    } finally { dom.window.close(); }
+});
+
+test('unknown player UI does not send real collection or drawer entries', () => {
+    const { dom, calls } = boot('/collection/playlists', 'unknown');
+    try {
+        assert.deepEqual(calls.routes, ['home']);
+        assert.doesNotMatch(JSON.stringify(calls.data), /Ma playlist|Ancienne donnée/);
+    } finally { dom.window.close(); }
+});
+
+
+test('collection can render more than 32 loaded playlists', () => {
+    const { dom, w, calls } = boot('/collection/playlists');
+    try {
+        const section = w.document.querySelector('#main-view section');
+        for (let n = 1; n <= 40; n++) {
+            const card = w.document.createElement('article');
+            card.dataset.testid = 'card';
+            const link = w.document.createElement('a');
+            link.href = '/playlist/1A' + String(n).padStart(20, '0');
+            link.textContent = 'Liste ' + n;
+            card.appendChild(link);
+            section.appendChild(card);
+        }
+        w.__sfNativeUiRefresh();
+        const payload = calls.data.filter(x => x.screen === 'media:playlists').at(-1);
+        assert.equal(payload.rows.length, 41);
+    } finally { dom.window.close(); }
+});
+
+test('reselecting the current library resends its rows after the native tab clears them', () => {
+    const { dom, w, calls } = boot('/collection/playlists');
+    try {
+        const before = calls.data.filter(x => x.screen === 'media:playlists').length;
+        assert.ok(before > 0);
+        assert.equal(w.__sfOpenLibrary(), true);
+        const after = calls.data.filter(x => x.screen === 'media:playlists');
+        assert.equal(after.length, before + 1, 'same page must resend the current data');
+        assert.equal(after.at(-1).rows[0].title, 'Ma playlist');
+    } finally { dom.window.close(); }
+});
+
+test('playlist details update after all tracks are removed from the page', () => {
+    const { dom, w, calls } = boot('/playlist/37i9dQZF1DXcBWIGoYBM5M');
+    try {
+        const card = w.document.querySelector('article a');
+        card.href = '/track/37i9dQZF1DXcBWIGoYBM5M';
+        w.__sfNativeUiRefresh();
+        let details = calls.data.filter(x => x.screen === 'detail');
+        assert.ok(details.at(-1).rows.some(row => row.uri.startsWith('spotify:track:')));
+        w.document.querySelector('article').remove();
+        w.__sfNativeUiRefresh();
+        details = calls.data.filter(x => x.screen === 'detail');
+        assert.deepEqual(details.at(-1).rows, [], 'old tracks must be cleared');
+    } finally { dom.window.close(); }
+});
+
+test('asynchronous empty transport reselects the same live library without a reload', async () => {
+    const { dom, w, calls } = boot('/collection/playlists');
+    try {
+        let loads = 0;
+        w.AndBridge.loadWebPlayerUrl = () => { loads++; };
+        w.__sfMelodixBridgeStarted = true;
+        w.fetchMediaItems = () => Promise.resolve([]);
+        const before = calls.data.filter(x => x.screen === 'media:playlists').length;
+        assert.equal(w.__sfOpenLibrary(), true);
+        await Promise.resolve();
+        assert.equal(calls.data.filter(x => x.screen === 'media:playlists').length, before + 1);
+        assert.equal(loads, 0);
+    } finally { dom.window.close(); }
+});
+
+test('library reselect with an unknown UI does not resurrect old account rows', () => {
+    const { dom, w, calls } = boot('/collection/playlists');
+    try {
+        w.__sfSpotifyAuthUiState = 'unknown';
+        const before = calls.data.length;
+        w.__sfOpenLibrary();
+        assert.equal(calls.routes.at(-1), 'home');
+        assert.doesNotMatch(JSON.stringify(calls.data.slice(before)), /Ma playlist|Ancienne donnée/);
+    } finally { dom.window.close(); }
+});
+
+test('a playlist detail sends all 40 loaded tracks, not only the first 32', () => {
+    const { dom, w, calls } = boot('/playlist/37i9dQZF1DXcBWIGoYBM5M');
+    try {
+        const section = w.document.querySelector('#main-view section');
+        w.document.querySelector('article').remove();
+        for (let n = 1; n <= 40; n++) {
+            const card = w.document.createElement('article');
+            card.dataset.testid = 'tracklist-row';
+            const link = w.document.createElement('a');
+            link.href = '/track/1A' + String(n).padStart(20, '0');
+            link.textContent = 'Morceau ' + n;
+            card.appendChild(link);
+            section.appendChild(card);
+        }
+        w.__sfNativeUiRefresh();
+        assert.equal(calls.data.filter(x => x.screen === 'detail').at(-1).rows.length, 40);
+    } finally { dom.window.close(); }
+});
+
+test('an older playlist fetch cannot navigate after a newer playlist was selected', async () => {
+    const { dom, w } = boot('/collection/playlists');
+    try {
+        const resolvers = [], loads = [];
+        w.__sfMelodixBridgeStarted = true;
+        w.AndBridge.loadWebPlayerUrl = url => loads.push(url);
+        w.fetchMediaItems = () => new Promise(resolve => resolvers.push(resolve));
+        w.__sfOpenCollection('spotify:playlist:1111111111111111111111');
+        w.__sfOpenCollection('spotify:playlist:2222222222222222222222');
+        resolvers[1]([]);
+        await Promise.resolve();
+        resolvers[0]([]);
+        await Promise.resolve();
+        assert.deepEqual(loads, ['https://open.spotify.com/playlist/2222222222222222222222']);
+    } finally { dom.window.close(); }
+});
+
+test('selecting Home cancels a pending playlist navigation', async () => {
+    const { dom, w } = boot('/');
+    try {
+        let finish;
+        const loads = [];
+        w.__sfMelodixBridgeStarted = true;
+        w.AndBridge.loadWebPlayerUrl = url => loads.push(url);
+        w.fetchMediaItems = () => new Promise(resolve => { finish = resolve; });
+        w.__sfOpenCollection('spotify:playlist:1111111111111111111111');
+        w.__sfNativeRequestHome();
+        finish([]);
+        await Promise.resolve();
+        assert.deepEqual(loads, []);
+    } finally { dom.window.close(); }
+});
+
+test('a deferred library request cannot override a later Home selection', async () => {
+    const { dom, w } = boot('/');
