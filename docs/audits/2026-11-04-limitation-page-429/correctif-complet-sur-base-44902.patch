+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const {JSDOM} = require('jsdom');
+const root=path.join(__dirname,'..');
+const read=p=>fs.readFileSync(path.join(root,p),'utf8');
+const diag=read('smali/com/melodix/music/WebPageDiagnostic.smali');
+const evidence=read('smali/com/melodix/music/WebLoadEvidence.smali');
+const client=read('smali/c91.smali');
+const probe=diag.match(/const-string v2, "(\(function\(\).*?\)\(\))"/)[1];
+function fixture(html='<body><div></div><div></div></body>', url='https://open.spotify.com/') {
+ const dom=new JSDOM(html,{url,runScripts:'outside-only'});
+ dom.window.MelodixRuntime={};dom.window.__sfNativeUiShellCompleted=true;dom.window.__sfMelodixBridgeStarted=true;dom.window.__sfNativeUiReadyNotified=true;
+ return dom;
+}
+
+test('D2 retains the previous 17 flags and adds bounded structural observations', () => {
+ const dom=fixture('<head><script>private inline content</script><meta http-equiv="Content-Security-Policy" content="private policy"></head><body><div>private page text</div><div role="alert">private alert</div></body>');
+ try {
+   Object.defineProperty(dom.window.document,'readyState',{value:'complete'});
+   Object.defineProperty(dom.window.navigator,'onLine',{value:true});
+   dom.window.performance.getEntriesByType = (type)=>type==='resource' ? [{initiatorType:'script',name:'https://private/path?token=secret'}] : [{responseStatus:403,name:'secret'}];
+   const result=dom.window.eval(probe);
+   assert.match(result,/^[01]{17}-[01]{16}-(?:000|[1-5][0-9]{2})$/);
+   assert.equal(result.slice(0,17),'11011100001010000');
+   assert.equal(result.split('-')[1],'1110100011111111');
+   assert.equal(result.split('-')[2],'403');
+   assert.doesNotMatch(result,/private|secret|https|token/);
+ } finally {dom.window.close();}
+});
+
+test('a foreign page cannot return content, timing, network or login information', () => {
+ const dom=fixture('<body><main id="main-view">secret</main><script src="https://example.com/private"></script></body>','https://example.com/');
+ try {dom.window.performance.getEntriesByType=()=>[{responseStatus:403,initiatorType:'script'}]; assert.equal(dom.window.eval(probe),'00000000000000000-0000000000000000-000');} finally {dom.window.close();}
+});
+
+test('HTTP, network and SSL callbacks are recorded only as bounded integers after each trusted main navigation', () => {
+ for(const method of ['start','http','network','ssl']) assert.match(client,new RegExp(`WebLoadEvidence;->${method}\\(`));
+ assert.match(evidence,/const-string v2, "open\.spotify\.com"/);
+ assert.match(evidence,/getScheme\(\)/); assert.match(evidence,/getUserInfo\(\)/); assert.match(evidence,/getPort\(\)/);
+ assert.match(evidence,/WeakReference/); assert.match(evidence,/isForMainFrame\(\)Z/);
+ assert.match(evidence,/const\/16 v2, 0x63/);
+ assert.match(evidence,/0 = aucune erreur observée, pas preuve de succès/);
+ assert.doesNotMatch(evidence,/getDescription|getUrl\(|getResponseHeaders|getRequestHeaders|Cookie|localStorage|clearCache|deleteAllData|loadUrl\(/);
+ for(const field of ['mainHttp','subHttpCount','subHttpLast','mainNetwork','subNetworkCount','subNetworkLast','sslCount','sslLast']) assert.match(evidence,new RegExp(`sput v0, Lcom/melodix/music/WebLoadEvidence;->${field}:I`));
+ assert.match(diag,/ScrollView/); assert.match(diag,/\[01\]\{17\}-\[01\]\{16\}/); assert.match(diag,/const\/16 v2, 0x27/);
+});
+
+test('missing optional timing APIs remain valid and never fabricate a response', () => {
+ const dom=fixture();
+ try {
+  dom.window.performance.getEntriesByType=undefined;
+  const result=dom.window.eval(probe); assert.match(result,/^[01]{17}-[01]{16}-(?:000|[1-5][0-9]{2})$/);
+  assert.equal(result.split('-')[1].slice(8,14),'000000');
+ } finally {dom.window.close();}
+});
