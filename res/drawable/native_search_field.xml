<?xml version="1.0" encoding="utf-8"?>
<!-- Focus is visible without changing the field's geometry or text contrast. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mel_search_bg" />
            <corners android:radius="24.0dip" />
            <stroke android:width="2.0dip" android:color="@color/mel_accent_deep" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mel_search_bg" />
            <corners android:radius="24.0dip" />
            <stroke android:width="1.0dip" android:color="@color/mel_stroke" />
        </shape>
    </item>
</selector>
