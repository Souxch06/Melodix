<?xml version="1.0" encoding="utf-8"?>
<!-- MEL-BUG-064: primary pill = accent gradient + white ripple press feedback. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/mel_glass_stroke">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/mel_text_primary" />
            <corners android:radius="999.0dip" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/mel_accent"
                android:endColor="@color/mel_accent_deep" />
            <corners android:radius="999.0dip" />
        </shape>
    </item>
</ripple>
