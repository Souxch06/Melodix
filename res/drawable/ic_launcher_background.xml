<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background: the Melodix night sky. Three stops of the same
     violet family the app uses (#150C2B -> #0B0B14 -> #07060F), painted as a
     vertical gradient so the launcher mask never shows a flat green-black. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/mel_shell_top"
        android:centerColor="@color/mel_shell_mid"
        android:endColor="@color/mel_shell_floor" />
</shape>
