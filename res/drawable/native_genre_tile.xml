<?xml version="1.0" encoding="utf-8"?>
<!-- Modulated by android:backgroundTintMode="multiply": white keeps the tile hue
     at the top, the grey end deepens it towards the bottom. The label sits at the
     top, so the palette itself must already pass contrast against white. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/mel_mask"
        android:endColor="@color/mel_tile_shade_bottom"
        android:type="linear" />
    <corners android:radius="@dimen/mel_tile_radius" />
    <stroke android:width="1.0dip" android:color="@color/mel_tile_edge" />
</shape>
