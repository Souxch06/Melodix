<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@drawable/session_glass_background"
    android:overScrollMode="never" android:scrollbars="none" android:clipToPadding="false"
    android:clickable="true" android:focusable="true" android:importantForAccessibility="no">
    <!-- FrameLayout is stretched by fillViewport, or grows with the card for small heights/IME. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/session_margin">
        <com.melodix.music.NativeSessionCard android:id="@+id/sessionCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical" android:gravity="center"
            android:padding="@dimen/session_card_padding" android:background="@drawable/session_glass_card" android:elevation="6dp">
            <ImageView android:id="@+id/sessionLogo" android:layout_width="80dp" android:layout_height="80dp" android:src="@drawable/session_brand" android:tint="@color/session_text" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/sessionBrand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="M E L O D I X" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/session_secondary" android:gravity="center" />
            <TextView android:id="@+id/sessionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="Melodix" android:textColor="@color/session_text" android:textSize="24sp" android:textStyle="bold"
                android:gravity="center" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/sessionSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textColor="@color/session_secondary" android:textSize="15sp" android:lineSpacingExtra="3dp" android:gravity="center" />
            <TextView android:id="@+id/sessionAction" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:padding="12dp"
                android:layout_marginTop="24dp" android:background="@drawable/session_glass_button" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" android:clickable="true" android:focusable="true" android:visibility="gone" />
            <TextView android:id="@+id/sessionSecondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:padding="12dp"
                android:layout_marginTop="12dp" android:background="@drawable/session_secondary_button" android:gravity="center"
                android:textColor="@color/session_text" android:textSize="16sp" android:clickable="true" android:focusable="true" android:visibility="gone" />
            <TextView android:id="@+id/sessionNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="Se reconnecter efface la session actuelle, tous les cookies et données Web de cette application, uniquement après ton appui." android:textSize="12sp" android:textColor="@color/session_secondary" android:gravity="center" android:visibility="gone" />
            <TextView android:id="@+id/sessionDisclosure" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:padding="12dp"
                android:layout_marginTop="12dp" android:gravity="center" android:text="Détails techniques" android:textSize="14sp" android:textColor="@color/session_text"
                android:background="@drawable/session_secondary_button" android:clickable="true" android:focusable="true" android:visibility="gone" />
            <LinearLayout android:id="@+id/sessionDetailPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/sessionDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:textSize="12sp" android:textColor="@color/session_secondary" android:lineSpacingExtra="2dp" />
                <TextView android:id="@+id/sessionCopy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:padding="12dp" android:layout_marginTop="12dp"
                    android:text="Copier le diagnostic" android:textSize="14sp" android:textColor="@color/session_text" android:gravity="center" android:background="@drawable/session_secondary_button" android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </com.melodix.music.NativeSessionCard>
    </FrameLayout>
</ScrollView>
