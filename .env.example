# Melodix (application Android) — exemples de configuration.
# NE JAMAIS committer un vrai fichier .env. Tout est OPTIONNEL : l'application
# se compile et fonctionne sans aucune de ces variables.

# URL du backend Melodix (métadonnées : recherche, albums, playlists Spotify).
# Sans cette variable, la recherche retombe sur le catalogue Audius et les
# sections personnelles sur l'historique local du téléphone.
MELODIX_BACKEND_URL=https://votre-backend-melodix.exemple.fr

# Clé API Audius du mainteneur (dashboard Audius, gratuite) : limites plus
# élevées. Jamais fournie par l'utilisateur. Sans elle, l'app utilise les
# nœuds publics de découverte Audius.
AUDIUS_API_KEY=

# --- Backend Melodix ---
# Le backend a son PROPRE .env.example dans server/.env.example
# (PORT, MELODIX_ALLOWED_ORIGINS, budgets, TTL…). Ces variables ne concernent
# que le serveur et ne doivent jamais être embarquées dans l'APK.
