# Exemples de configuration Melodix (jamais de vraies valeurs ici).
# Copier dans un fichier .env à la racine — ignoré par Git (.gitignore).

# URL du backend Melodix (métadonnées catalogue publiques, voir server/).
# Sans elle : repli automatique sur le catalogue Audius + l'historique local.
MELODIX_BACKEND_URL=https://melodix-api.exemple.fr

# Client ID de l'application Spotify du mainteneur (OAuth Authorization Code
# + PKCE au démarrage). Un Client ID n'est PAS un secret — mais aucun Client
# Secret n'est utilise par l'application mobile : PKCE l'exclut.
# Redirect URIs à déclarer dans le dashboard Spotify :
#   melodix://callback                  (APK installé)
#   exp://192.168.x.x:8081/--/callback  (Expo Go)
SPOTIFY_CLIENT_ID=exemple_de_client_id_32_caracteres

# Clé API Audius (gratuite, dashboard Audius) — facultative.
AUDIUS_API_KEY=exemple_de_cle_audius
