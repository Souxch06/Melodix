{
  "name": "melodix-backend",
  "version": "3.0.0",
  "private": true,
  "description": "Melodix backend: Spotify metadata (unofficial web-player techniques, isolated & replaceable) + Audius audio matching. No secrets are ever sent to the client.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tests": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "test": "npm run build:tests && node --test dist-test/src/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
